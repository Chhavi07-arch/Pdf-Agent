# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# --- Mistral ---
MISTRAL_API_KEY=your_key_here         # Get from console.mistral.ai/api-keys

# --- Qdrant (REQUIRED) ---
# A running Qdrant server is mandatory — the in-memory fallback has been removed.
# Point these at a Qdrant Cloud cluster (or any reachable Qdrant instance).
# If QDRANT_URL is unset or the server is unreachable, /upload and /chat return
# HTTP 503 "Qdrant server not working" rather than degrading to ephemeral memory.
QDRANT_URL=                           # e.g. https://abc123.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=                       # Qdrant Cloud API key

# --- App config ---
MAX_PDF_SIZE_MB=20                    # Reject uploads larger than this
MIN_RETRIEVAL_SCORE=0.20              # Minimum Qdrant cosine similarity score (0–1).
                                      # Chunks below this are dropped before the LLM sees them.
                                      # Lower = more permissive; higher = stricter.

# --- Memory / deployment ---
# Cross-encoder reranking loads a second transformer model (~best answer quality,
# higher RAM). Toggle it by host memory:
#   Render Free (512 MB):        ENABLE_RERANKING=false   (deployable; hybrid-only retrieval)
#   Higher-memory (>=2 GB) host: ENABLE_RERANKING=true    (full reranking, best quality)
# Default is true. Transformer models always lazy-load on first use, never at startup.
ENABLE_RERANKING=true

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
