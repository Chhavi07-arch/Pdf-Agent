# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# --- Mistral ---
MISTRAL_API_KEY=your_key_here         # Get from console.mistral.ai/api-keys

# --- App config ---
MAX_PDF_SIZE_MB=20                    # Reject uploads larger than this
TOP_K_CHUNKS=5                        # How many chunks to retrieve per query
CHUNK_SIZE_TOKENS=500                 # Target token count per chunk
CHUNK_OVERLAP_TOKENS=50               # Overlap between consecutive chunks

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data      # Local directory for ChromaDB persistence
                                      # On Render, use /tmp/chroma_data (ephemeral is fine for assessment)

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
